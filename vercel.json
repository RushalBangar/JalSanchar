{
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/frontend/index.html" },
    { "source": "/collector", "destination": "/frontend/dashboard.html" },
    { "source": "/collector.html", "destination": "/frontend/dashboard.html" },
    { "source": "/dashboard", "destination": "/frontend/dashboard.html" },
    { "source": "/dashboard.html", "destination": "/frontend/dashboard.html" },
    { "source": "/driver", "destination": "/frontend/driver.html" },
    { "source": "/driver.html", "destination": "/frontend/driver.html" },
    { "source": "/panchayat", "destination": "/frontend/panchayat.html" },
    { "source": "/panchayat.html", "destination": "/frontend/panchayat.html" },
    { "source": "/login", "destination": "/frontend/login.html" },
    { "source": "/login.html", "destination": "/frontend/login.html" },
    { "source": "/(.*)", "destination": "/frontend/$1" }
  ]
}
